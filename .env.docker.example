# ===================================================================
#  Configuration Environnement Docker — BCRG RUCKUS WI-FI MANAGER
# ===================================================================

# Port public d'accès à l'application Web (ex: 3001)
PORT=3001

# Base de Données PostgreSQL
DB_NAME=ruckus
DB_USER=postgres
DB_PASSWORD=BcrgSecureDb2026!
DB_PORT=5432

# Sécurité & Clés Cryptographiques
JWT_SECRET=bcrg_ruckus_jwt_supersecret_key_2026
ENCRYPTION_KEY=bcrg_32_bytes_super_secret_encryption_key_2026

# Compte Super Administrateur initial (créé automatiquement au premier démarrage)
DEFAULT_ADMIN_EMAIL=admin@bcrg.local
DEFAULT_ADMIN_PASSWORD=Bcrg@dmin@2026
DEFAULT_ADMIN_MATRICULE=ADMIN001

# Réseau Wi-Fi cible officiel
WIFI_DEFAULT_SSID=CORPORATE-BCRG

# Configuration SMTP par défaut (Office 365 / Outlook / Exchange)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=wifi-support@bcrg-guinee.org
SMTP_PASS=votre_mot_de_passe_ou_mot_de_passe_application
SMTP_FROM=Support IT BCRG <wifi-support@bcrg-guinee.org>

# Activation du mode HTTPS strict (Mettre "true" si SSL/TLS activé en reverse-proxy)
USE_HTTPS=false
ENABLE_CLUSTER=true
