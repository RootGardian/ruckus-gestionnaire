# ===================================================================
#  Configuration Environnement — BCRG RUCKUS WI-FI MANAGER (Backend)
# ===================================================================
NODE_ENV=development
PORT=5001

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=ruckus
DB_SSL=false

# Sécurité & Chiffrement des mots de passe en base
JWT_SECRET=your_jwt_secret_change_in_production_2026
ENCRYPTION_KEY=your_32_byte_secret_key_for_secrets_at_rest_2026

# Administrateur initial créé automatiquement au premier démarrage
DEFAULT_ADMIN_EMAIL=admin@bcrg.local
DEFAULT_ADMIN_PASSWORD=Bcrg@dmin@2026
DEFAULT_ADMIN_MATRICULE=ADMIN001

# Réseau Wi-Fi cible officiel
WIFI_DEFAULT_SSID=CORPORATE-BCRG

# Configuration SMTP par défaut (Office 365 / Outlook / Exchange)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=wifi-support@bcrg-guinee.org
SMTP_PASS=your_app_password
SMTP_FROM=Support IT BCRG <wifi-support@bcrg-guinee.org>
SMTP_IGNORE_TLS=false

# CORS & Domaine Frontend
FRONTEND_URL=http://localhost:5173
USE_HTTPS=false
